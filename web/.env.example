# Copy this file to web/.env.local and fill in the values. NEVER commit .env.local.
# These are the env vars the WEB APP reads — the station backend has its own,
# separate `.env` at the repo root (src/config.py); the two never share a file.
#
# Every NEXT_PUBLIC_* value is INLINED AT BUILD TIME: locally, restart `npm run dev`
# after an edit; on Vercel, set them in Project → Settings → Environment Variables and
# REDEPLOY, or nothing changes. All of them are optional — unset, the site falls back
# to its safe defaults (coming-soon front page, no stream, no feeds, no analytics).

# --- Email signup (A2-T3): Buttondown ---
# Server-side ONLY — never expose to the client (no NEXT_PUBLIC_ prefix).
# The /api/subscribe route uses it to add emails to the list.
# Get it at https://buttondown.com/ -> Settings -> Programming -> API key.
BUTTONDOWN_API_KEY=

# --- The front door (R7.4) ---
# While this is anything other than the literal string "false", `/` is the coming-soon
# screen and the player lives at `/listen` (unindexed, shareable by hand). Set it to
# "false" and redeploy to make the station the front page: `/` becomes the player and
# `/listen` redirects there. Defaults to the SAFE state — a missing or mistyped value
# can only leave the old page up, never advertise a stream that isn't running.
NEXT_PUBLIC_COMING_SOON=true

# Plausible analytics (MARKETING M1) — the site's domain, e.g. settlementradio.com.
# Empty = no analytics script is sent at all (local and preview builds stay silent).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- The player page (R7.1): the stream + the public feeds ---
# All four are PUBLIC (NEXT_PUBLIC_) and INLINED AT BUILD TIME — set them as Vercel
# env vars and redeploy to change them; a running build won't pick up new values.
#
# The live audio stream (Icecast mp3 or HLS), from the C7 box. Leave EMPTY and the
# player renders with the control disabled and says the stream isn't live yet.
NEXT_PUBLIC_STREAM_URL=
# Where the three read-only JSON feeds are served (no trailing slash), e.g.
# https://stream.settlementradio.com/feeds — the station writes nowplaying.json,
# schedule-public.json and djs-public.json (R7.0). Needs CORS for this domain; the
# nginx recipe is in docs/ADMIN_MANUAL.md ("The public schedule & DJs feeds").
# Leave EMPTY and the player still plays, with a static on-air card.
NEXT_PUBLIC_FEEDS_BASE_URL=
# How often the player re-reads the now-playing feed, in seconds (default 20).
NEXT_PUBLIC_FEED_POLL_SEC=
# How often /schedule and /voices re-read the SLOW feeds, in seconds (default 300).
# The "on air now" highlight doesn't depend on this — it's recomputed from the local
# clock every 30s — so this only governs how fast a GRID EDIT reaches open pages.
NEXT_PUBLIC_SLOW_FEED_POLL_SEC=
# Optional support link (Ko-fi at MARKETING M1). Hidden while unset.
NEXT_PUBLIC_SUPPORT_URL=
# R7.3 stretch: offer a short voice sample per host on /voices ("true" to enable).
# Expects OPERATOR-CURATED clips at web/public/voices/<host-id>.mp3 (vell.mp3,
# the-archivist.mp3, …) — never an auto-published segment. Hosts without a clip show
# no control, so it's safe to enable with only some recorded.
NEXT_PUBLIC_VOICE_SAMPLES=
