# Copy this file to web/.env.local and fill in the values. NEVER commit .env.local.
# These are the env vars the web app (A2) needs.

# --- Email signup (A2-T3): Buttondown ---
# Server-side ONLY — never expose to the client (no NEXT_PUBLIC_ prefix).
# The /api/subscribe route uses it to add emails to the list.
# Get it at https://buttondown.com/ -> Settings -> Programming -> API key.
BUTTONDOWN_API_KEY=

# --- The player page (R7.1): the stream + the public feeds ---
# All four are PUBLIC (NEXT_PUBLIC_) and INLINED AT BUILD TIME — set them as Vercel
# env vars and redeploy to change them; a running build won't pick up new values.
#
# The live audio stream (Icecast mp3 or HLS), from the C7 box. Leave EMPTY and the
# player renders with the control disabled and says the stream isn't live yet.
NEXT_PUBLIC_STREAM_URL=
# Where the three read-only JSON feeds are served (no trailing slash), e.g.
# https://stream.settlementradio.com/feeds — the station writes nowplaying.json,
# schedule-public.json and djs-public.json (R7.0). Needs CORS for this domain; the
# nginx recipe is in docs/ADMIN_MANUAL.md ("The public schedule & DJs feeds").
# Leave EMPTY and the player still plays, with a static on-air card.
NEXT_PUBLIC_FEEDS_BASE_URL=
# How often the player re-reads the now-playing feed, in seconds (default 20).
NEXT_PUBLIC_FEED_POLL_SEC=
# Optional support link (Ko-fi at MARKETING M1). Hidden while unset.
NEXT_PUBLIC_SUPPORT_URL=
