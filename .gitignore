# Secrets — the live file AND every variant (.env.local, .env.bak, .env.prod…).
# The pattern used to be a bare `.env`, which left a hand-made `.env.bak` (or an
# editor's `.env.save`) committable. The TEMPLATE stays tracked and current.
.env
.env.*
!.env.example

# Generated audio & assets (kept as empty dirs via .gitkeep)
segments/*
!segments/.gitkeep
assets/*
!assets/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Q8's blind-pool ANSWER KEY (docs/audit/blind/). The unlabelled scripts are committed so
# the auditor can read them; the key that says which arm each came from must not be, or
# the blind read stops being blind.
docs/audit/blind/key.json

# Playout runtime (pids, logs)
.run/

# macOS junk
.DS_Store
